# Copy desired entries into .env; preserve any existing credentials.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=liquid/lfm-2.5-embedding-350m:free
# Leave empty to use the model's native dimensions. Not every model supports overriding this.
OPENROUTER_EMBEDDING_DIMENSIONS=
OPENROUTER_CHAT_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_RETRIES=3
OPENROUTER_BATCH_SIZE=32
# Optional, provider-specific. Query/document types are separate.
OPENROUTER_DOCUMENT_INPUT_TYPE=
OPENROUTER_QUERY_INPUT_TYPE=
OPENROUTER_DOCUMENT_PREFIX="document: "
OPENROUTER_QUERY_PREFIX="query: "
# Bump when a model alias is updated to invalidate cached vectors and indexes.
OPENROUTER_EMBEDDING_REVISION=1
RAG_DATA_DIR=data/vlearn-pack
RAG_ARTIFACTS_DIR=artifacts
# auto: Liquid's tokenizer for Liquid; cl100k_base for OpenAI; UTF-8 byte budget otherwise.
RAG_TOKENIZER=auto
RAG_CHUNK_TOKENS=360
RAG_CHUNK_OVERLAP=40
RAG_CONTEXT_TOKENS=6000
RAG_RETRIEVAL_K=8
RAG_CANDIDATE_K=20
RAG_RERANK=false
# Optional manifest mapping; copy config/lesson_map.example.json and review before using.
RAG_LESSON_MAP=
RAG_REVIEW_FILE=
# Empty URL uses local on-disk Qdrant. Stop the API before CLI index/search in local mode.
QDRANT_URL=
QDRANT_API_KEY=
# Optional API bearer token. Bind the server to loopback unless authentication is configured.
RAG_API_TOKEN=
